<ui version="4.0"><class>ClientWindow</class><widget class="QWidget" name="ClientWindow"><property name="geometry"><rect><x>0</x><y>0</y><width>1080</width><height>650</height></rect></property><property name="windowTitle"><string>Network Client - TCP / UDP / WebSocket</string></property><layout class="QVBoxLayout" name="mainLayout"><item><layout class="QHBoxLayout" name="connectControls"><item><widget class="QLabel" name="ipLabel"><property name="text"><string>IP Server:</string></property></widget></item><item><widget class="QLineEdit" name="serverIp"><property name="text"><string>127.0.0.1</string></property></widget></item><item><widget class="QLabel" name="portLabel"><property name="text"><string>Cổng:</string></property></widget></item><item><widget class="QSpinBox" name="serverPort"><property name="minimum"><number>1</number></property><property name="maximum"><number>65535</number></property><property name="value"><number>45455</number></property></widget></item><item><widget class="QLabel" name="protocolLabel"><property name="text"><string>Giao thức:</string></property></widget></item><item><widget class="QComboBox" name="protocolBox"><item><property name="text"><string>TCP</string></property></item><item><property name="text"><string>UDP</string></property></item><item><property name="text"><string>WebSocket</string></property></item></widget></item><item><widget class="QPushButton" name="connectButton"><property name="text"><string>Kết nối / Mở cổng</string></property></widget></item><item><widget class="QPushButton" name="disconnectButton"><property name="text"><string>Ngắt kết nối</string></property></widget></item></layout></item><item><layout class="QHBoxLayout" name="clientBody"><item><layout class="QVBoxLayout" name="conversation"><item><widget class="QLabel" name="messageLabel"><property name="text"><string>Tin nhắn và nhật ký Client</string></property></widget></item><item><widget class="QWidget" name="messageHost" native="true"><property name="mi